{
  "schemaVersion": "1.0",
  "name": "shangan-job-search-harness",
  "version": "2.0.0",
  "description": "Artifact-gated job source collection, download, deterministic parsing, evidence extraction, filtering, and release validation.",
  "workingDirectory": ".",
  "runDirectory": "docs/runs/job-search",
  "maxRetryRounds": 3,
  "fallbackPolicy": {
    "downloadFailure": "use_last_successful_artifacts",
    "fallbackStatus": "stale_fallback",
    "requiredArtifacts": [
      "data/jobs/index.json",
      "data/jobs/catalog/eligible.jsonl",
      "data/jobs/catalog/needs-confirmation.jsonl"
    ]
  },
  "outputs": {
    "index": "data/jobs/index.json",
    "eligibleCatalog": "data/jobs/catalog/eligible.jsonl",
    "needsConfirmationCatalog": "data/jobs/catalog/needs-confirmation.jsonl",
    "reportName": "job-search-report.json"
  },
  "agents": {
    "collector": {
      "role": "检索员",
      "prompt": "docs/harnesses/job-search/prompts/01-collector.md"
    },
    "downloader": {
      "role": "下载员",
      "prompt": "docs/harnesses/job-search/prompts/02-downloader.md"
    },
    "parser": {
      "role": "解析员",
      "prompt": "docs/harnesses/job-search/prompts/03-parser.md"
    },
    "extractor": {
      "role": "证据抽取员",
      "prompt": "docs/harnesses/job-search/prompts/04-extractor.md"
    },
    "filter": {
      "role": "资格筛选员",
      "prompt": "docs/harnesses/job-search/prompts/05-filter.md"
    },
    "reporter": {
      "role": "整理员",
      "prompt": "docs/harnesses/job-search/prompts/06-reporter.md"
    }
  },
  "subAgents": [
    {
      "id": "civil-service-source-finder",
      "role": "公务员来源检索员",
      "stageId": "01",
      "scope": "国考、北京、河北、天津公务员岗位表"
    },
    {
      "id": "institution-source-finder",
      "role": "事业单位来源检索员",
      "stageId": "01",
      "scope": "画像地区事业单位公告与岗位表"
    },
    {
      "id": "military-civilian-source-finder",
      "role": "军队文职来源检索员",
      "stageId": "01",
      "scope": "军队文职全国入口与岗位表"
    },
    {
      "id": "state-enterprise-source-finder",
      "role": "国央企来源检索员",
      "stageId": "01",
      "scope": "国资委、央企和画像地区国企招聘入口"
    },
    {
      "id": "llm-table-extractor",
      "role": "模型抽取员",
      "stageId": "04",
      "scope": "只处理确定性解析器输出的失败片段，并返回原文坐标"
    }
  ],
  "stages": [
    {
      "id": "01",
      "name": "collect",
      "agent": "collector",
      "executionMode": "agent",
      "description": "Discover official campaigns and submit evidence-backed candidates.",
      "command": [],
      "inputs": [
        "data/user-profile/profile.json",
        "data/jobs/source-registry.json",
        "data/jobs/sources.json"
      ],
      "outputs": [
        "stage-results/01-submitted.json"
      ]
    },
    {
      "id": "02",
      "name": "download",
      "agent": "downloader",
      "executionMode": "command",
      "description": "Download selected official attachments.",
      "command": [
        "python",
        ".agents/skills/job-filter/scripts/job_pipeline.py",
        "download"
      ],
      "fallbackOnFailure": true,
      "inputs": [
        "data/jobs/sources.json"
      ],
      "outputs": [
        "data/jobs/sources/**"
      ]
    },
    {
      "id": "03",
      "name": "parse",
      "agent": "parser",
      "executionMode": "command",
      "description": "Deterministically normalize official attachments and emit extraction fragments.",
      "command": [
        "python",
        ".agents/skills/job-filter/scripts/job_pipeline.py",
        "parse"
      ],
      "inputs": [
        "data/jobs/sources/**"
      ],
      "outputs": [
        "parsed-positions.jsonl",
        "extraction-fragments.json"
      ]
    },
    {
      "id": "04",
      "name": "extract",
      "agent": "extractor",
      "executionMode": "conditional_agent",
      "conditionArtifact": "extraction-fragments.json",
      "description": "Resolve parser failures from original evidence only.",
      "command": [],
      "inputs": [
        "extraction-fragments.json"
      ],
      "outputs": [
        "stage-results/04-submitted.json"
      ]
    },
    {
      "id": "05",
      "name": "filter",
      "agent": "filter",
      "executionMode": "command",
      "description": "Apply strict profile decisions and prepare guarded formal outputs.",
      "command": [
        "python",
        ".agents/skills/job-filter/scripts/job_pipeline.py",
        "filter"
      ],
      "inputs": [
        "data/user-profile/profile.json",
        "parsed-positions.jsonl",
        "stage-results/04-submitted.json"
      ],
      "outputs": [
        "data/jobs/index.json",
        "data/jobs/catalog/eligible.jsonl",
        "data/jobs/catalog/needs-confirmation.jsonl"
      ]
    },
    {
      "id": "06",
      "name": "report",
      "agent": "reporter",
      "executionMode": "command",
      "description": "Validate formal outputs and write the run report.",
      "command": [
        "python",
        ".agents/skills/job-filter/scripts/job_pipeline.py",
        "validate"
      ],
      "inputs": [
        "data/jobs/index.json",
        "data/jobs/catalog/eligible.jsonl",
        "data/jobs/catalog/needs-confirmation.jsonl"
      ],
      "outputs": [
        "job-search-report.json"
      ]
    }
  ]
}
