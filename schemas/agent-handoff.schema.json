{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shangan.local/schemas/agent-handoff.schema.json",
  "title": "Agent Handoff",
  "type": "object",
  "required": [
    "schemaVersion",
    "handoffId",
    "createdAt",
    "stageId",
    "status",
    "task",
    "summary"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "handoffId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "stageId": {
      "type": "string",
      "pattern": "^0[1-8]$"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "awaiting_review",
        "has_bugs",
        "all_passed"
      ]
    },
    "fromAgent": {
      "type": "string"
    },
    "toAgent": {
      "type": "string"
    },
    "task": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "properties": {
        "ownedPaths": {
          "$ref": "#/$defs/stringArray"
        },
        "excludedPaths": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "blockers": {
      "$ref": "#/$defs/stringArray"
    },
    "nextActions": {
      "$ref": "#/$defs/stringArray"
    },
    "notes": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
