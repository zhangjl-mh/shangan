{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shangan.local/schemas/harness-execution.schema.json",
  "title": "Harness Execution",
  "type": "object",
  "required": [
    "schemaVersion",
    "executionId",
    "harness",
    "startedAt",
    "updatedAt",
    "status",
    "requirement",
    "currentStage",
    "repairRound",
    "repairMode",
    "pendingStages",
    "steps",
    "ownershipViolations"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string"
    },
    "harness": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "initialized",
        "running",
        "paused",
        "all_passed",
        "has_bugs",
        "awaiting_review"
      ]
    },
    "workingDirectory": {
      "type": "string"
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    },
    "requirement": {
      "type": "object",
      "required": [
        "id",
        "title",
        "objective",
        "ownedPaths",
        "excludedPaths"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "ownedPaths": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "excludedPaths": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": true
    },
    "currentStage": {
      "type": ["string", "null"],
      "pattern": "^0[1-8]$"
    },
    "repairRound": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "repairMode": {
      "type": "boolean"
    },
    "pendingStages": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^0[1-8]$"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "stageId",
          "attempt",
          "repairRound",
          "status",
          "startedAt",
          "finishedAt",
          "exitCode",
          "artifacts",
          "writeAudit"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "stageId": {
            "type": "string",
            "pattern": "^0[1-8]$"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "repairRound": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "command": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "exitCode": {
            "type": ["integer", "null"]
          },
          "summary": {
            "type": "string"
          },
          "artifacts": {
            "$ref": "#/$defs/stringArray"
          },
          "writeAudit": {
            "type": "object",
            "required": ["changedPaths", "violations"],
            "properties": {
              "changedPaths": {
                "$ref": "#/$defs/stringArray"
              },
              "violations": {
                "$ref": "#/$defs/stringArray"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "ownershipViolations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stageId", "attempt", "paths"],
        "properties": {
          "stageId": {
            "type": "string",
            "pattern": "^0[1-8]$"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "paths": {
            "$ref": "#/$defs/nonEmptyStringArray"
          }
        },
        "additionalProperties": false
      }
    },
    "result": {
      "type": "object",
      "properties": {
        "exitCode": {
          "type": ["integer", "null"]
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "step": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "artifacts": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": true
}
