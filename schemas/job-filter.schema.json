{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shangan.local/schemas/job-filter.schema.json",
  "title": "Job Catalog Index",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "asOf",
    "profileSnapshot",
    "eligibleCatalog",
    "needsConfirmationCatalog",
    "sources",
    "stats",
    "coverage",
    "errors"
  ],
  "properties": {
    "schemaVersion": { "const": "4.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "asOf": { "type": "string", "format": "date-time" },
    "profileSnapshot": {
      "type": "object",
      "required": ["sha256", "updatedAt", "unknownFields"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "unknownFields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "eligibleCatalog": { "$ref": "#/$defs/catalogArtifact" },
    "needsConfirmationCatalog": { "$ref": "#/$defs/catalogArtifact" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sourceId",
          "label",
          "category",
          "cycle",
          "selectionMode",
          "portalUrl",
          "evidenceUrl",
          "allowedHosts",
          "registration",
          "attachments"
        ],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "category": { "$ref": "#/$defs/jobCategory" },
          "cycle": { "type": "string", "minLength": 1 },
          "selectionMode": {
            "enum": ["current", "previous_reference"]
          },
          "examAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "portalUrl": { "type": "string", "format": "uri" },
          "evidenceUrl": { "type": "string", "format": "uri" },
          "allowedHosts": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "registration": { "$ref": "#/$defs/registration" },
          "attachments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "url", "path", "sha256", "size"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "format": "uri" },
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "size": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "stats": {
      "type": "object",
      "required": [
        "processed",
        "eligible",
        "needsConfirmation",
        "excluded",
        "currentCampaigns",
        "referenceCampaigns",
        "application"
      ],
      "properties": {
        "processed": { "type": "integer", "minimum": 0 },
        "eligible": { "type": "integer", "minimum": 0 },
        "needsConfirmation": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 },
        "currentCampaigns": { "type": "integer", "minimum": 0 },
        "referenceCampaigns": { "type": "integer", "minimum": 0 },
        "application": {
          "type": "object",
          "required": ["upcoming", "open", "closed", "unknown"],
          "properties": {
            "upcoming": { "type": "integer", "minimum": 0 },
            "open": { "type": "integer", "minimum": 0 },
            "closed": { "type": "integer", "minimum": 0 },
            "unknown": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "requiredCategories",
        "registeredCategories",
        "catalogCategories",
        "missingCatalogCategories"
      ],
      "properties": {
        "requiredCategories": {
          "type": "array",
          "items": { "$ref": "#/$defs/jobCategory" },
          "uniqueItems": true
        },
        "registeredCategories": {
          "type": "array",
          "items": { "$ref": "#/$defs/jobCategory" },
          "uniqueItems": true
        },
        "catalogCategories": {
          "type": "array",
          "items": { "$ref": "#/$defs/jobCategory" },
          "uniqueItems": true
        },
        "missingCatalogCategories": {
          "type": "array",
          "items": { "$ref": "#/$defs/jobCategory" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "message"],
        "properties": {
          "source": { "type": "string" },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "catalogArtifact": {
      "type": "object",
      "required": ["path", "rowCount", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "rowCount": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "jobCategory": {
      "enum": [
        "civil_service",
        "institution",
        "military_civilian",
        "state_owned_enterprise"
      ]
    },
    "registration": {
      "type": "object",
      "required": ["opensAt", "closesAt"],
      "properties": {
        "opensAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "closesAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
