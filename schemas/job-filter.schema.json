{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shangan.local/schemas/job-filter.schema.json",
  "title": "Job SQLite Build Metadata",
  "type": "object",
  "required": [
    "schemaVersion",
    "buildId",
    "generatedAt",
    "asOf",
    "profileSnapshot",
    "stats",
    "coverage",
    "errors"
  ],
  "properties": {
    "schemaVersion": { "const": "5.0" },
    "buildId": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "asOf": { "type": "string", "format": "date-time" },
    "profileSnapshot": {
      "type": "object",
      "required": ["sha256", "updatedAt", "unknownFields"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "unknownFields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "stats": {
      "type": "object",
      "required": [
        "processed",
        "eligible",
        "needsConfirmation",
        "excluded",
        "currentCampaigns",
        "referenceCampaigns",
        "application"
      ],
      "properties": {
        "processed": { "type": "integer", "minimum": 0 },
        "eligible": { "type": "integer", "minimum": 0 },
        "needsConfirmation": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 },
        "currentCampaigns": { "type": "integer", "minimum": 0 },
        "referenceCampaigns": { "type": "integer", "minimum": 0 },
        "application": {
          "type": "object",
          "required": ["upcoming", "open", "closed", "unknown"],
          "properties": {
            "upcoming": { "type": "integer", "minimum": 0 },
            "open": { "type": "integer", "minimum": 0 },
            "closed": { "type": "integer", "minimum": 0 },
            "unknown": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "requiredCategories",
        "registeredCategories",
        "catalogCategories",
        "missingCatalogCategories"
      ],
      "properties": {
        "requiredCategories": { "$ref": "#/$defs/categories" },
        "registeredCategories": { "$ref": "#/$defs/categories" },
        "catalogCategories": { "$ref": "#/$defs/categories" },
        "missingCatalogCategories": { "$ref": "#/$defs/categories" }
      },
      "additionalProperties": false
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "message"],
        "properties": {
          "source": { "type": "string" },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "jobCategory": {
      "enum": [
        "civil_service",
        "institution",
        "military_civilian",
        "state_owned_enterprise"
      ]
    },
    "categories": {
      "type": "array",
      "items": { "$ref": "#/$defs/jobCategory" },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
