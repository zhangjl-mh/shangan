{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shangan.local/schemas/job-filter.schema.json",
  "title": "Job Catalog Index",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "cycle",
    "profileSnapshot",
    "catalog",
    "eligibleCatalog",
    "sources",
    "stats"
  ],
  "properties": {
    "schemaVersion": { "const": "3.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "cycle": { "type": "string", "minLength": 1 },
    "profileSnapshot": {
      "type": "object",
      "required": ["sha256", "updatedAt", "unknownFields"],
      "properties": {
        "sha256": { "type": "string", "minLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time" },
        "unknownFields": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "catalog": {
      "type": "object",
      "required": ["path", "rowCount", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "rowCount": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "minLength": 64 }
      },
      "additionalProperties": false
    },
    "eligibleCatalog": {
      "type": "object",
      "required": ["path", "rowCount", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "rowCount": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "minLength": 64 }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["examId", "label", "portalUrl", "registration", "attachments"],
        "properties": {
          "examId": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "portalUrl": { "type": "string", "format": "uri" },
          "registration": {
            "type": "object",
            "required": ["opensAt", "closesAt"],
            "properties": {
              "opensAt": { "type": "string", "format": "date-time" },
              "closesAt": { "type": "string", "format": "date-time" }
            },
            "additionalProperties": false
          },
          "attachments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "url", "path", "sha256", "size"],
              "properties": {
                "id": { "type": "string" },
                "url": { "type": "string", "format": "uri" },
                "path": { "type": "string" },
                "sha256": { "type": "string", "minLength": 64 },
                "size": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "stats": {
      "type": "object",
      "required": ["total", "eligible", "needsConfirmation", "ineligible", "active", "historical"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "eligible": { "type": "integer", "minimum": 0 },
        "needsConfirmation": { "type": "integer", "minimum": 0 },
        "ineligible": { "type": "integer", "minimum": 0 },
        "active": { "type": "integer", "minimum": 0 },
        "historical": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "message"],
        "properties": {
          "source": { "type": "string" },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
