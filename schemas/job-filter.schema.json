{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shangan.local/schemas/job-filter.schema.json",
  "title": "Job Filter Result",
  "type": "object",
  "required": [
    "schemaVersion",
    "domain",
    "cycle",
    "generatedAt",
    "runId",
    "completeness",
    "profileSnapshot",
    "sources",
    "catalog",
    "decisions",
    "positions",
    "pendingVerification",
    "excluded",
    "audit"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string"
    },
    "cycle": {
      "type": ["string", "integer"]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "completeness": {
      "type": "string"
    },
    "profileSnapshot": {
      "type": "object",
      "required": ["hash", "updatedAt", "unknownFields"],
      "properties": {
        "hash": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "unknownFields": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": true
    },
    "sourceScope": {
      "$ref": "#/$defs/stringArray"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "catalog": {
      "$ref": "#/$defs/fileIndex"
    },
    "decisions": {
      "$ref": "#/$defs/fileIndex"
    },
    "positions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/position"
      }
    },
    "referencePositions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/position"
      }
    },
    "pendingVerification": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/position"
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/excludedPosition"
      }
    },
    "audit": {
      "type": "object",
      "required": [
        "sourceRows",
        "validRows",
        "eligible",
        "ineligible",
        "needsConfirmation"
      ],
      "properties": {
        "sourceRows": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "validRows": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "duplicateRows": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "skippedRows": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "parseErrors": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "eligible": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "ineligible": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "needsConfirmation": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "currentActionable": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "inactiveEligible": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "interviewRosterRows": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "interviewPositionCodes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "conservation": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        }
      },
      "additionalProperties": true
    },
    "notes": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "$defs": {
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "required": ["id", "name", "url", "checkedAt"],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "portalUrl": {
          "type": "string",
          "format": "uri"
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        },
        "artifact": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "rows": {
              "$ref": "#/$defs/nonNegativeInteger"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "fileIndex": {
      "type": "object",
      "required": ["path", "rowCount"],
      "properties": {
        "path": {
          "type": "string"
        },
        "rowCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "profileIndependent": {
          "type": "boolean"
        },
        "triState": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": true
    },
    "position": {
      "type": "object",
      "required": ["id", "title", "organization"],
      "properties": {
        "id": {
          "type": "string"
        },
        "positionCode": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "department": {
          "type": "string"
        },
        "cycle": {
          "type": ["string", "integer"]
        },
        "recruitCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "region": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "eligibility": {
          "type": "string"
        },
        "matchScore": {
          "type": "number"
        },
        "matchReasons": {
          "$ref": "#/$defs/stringArray"
        },
        "confirmationFields": {
          "$ref": "#/$defs/stringArray"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": true
    },
    "excludedPosition": {
      "type": "object",
      "required": ["id", "title", "organization", "reasons"],
      "properties": {
        "id": {
          "type": "string"
        },
        "positionCode": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "failedFields": {
          "$ref": "#/$defs/stringArray"
        },
        "reasons": {
          "$ref": "#/$defs/stringArray"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
